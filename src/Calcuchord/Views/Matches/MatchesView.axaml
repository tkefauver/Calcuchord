<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="800"
             d:DesignHeight="450"
             xmlns:sys="clr-namespace:System;assembly=netstandard"
             xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:controls="clr-namespace:Material.Styles.Controls;assembly=Material.Styles"
             xmlns:dlg="clr-namespace:DialogHostAvalonia;assembly=DialogHost.Avalonia"
             xmlns:local="clr-namespace:Calcuchord"
             xmlns:common="clr-namespace:MonkeyPaste.Common.Avalonia;assembly=MonkeyPaste.Common.Avalonia"
             x:DataType="local:MainViewModel"
             x:Class="Calcuchord.MatchesView">
    <UserControl.Styles>
        <Style Selector="TextBlock.empty-label">
            <Setter Property="FontSize"
                    Value="34" />
            <Setter Property="HorizontalAlignment"
                    Value="Stretch" />
            <Setter Property="VerticalAlignment"
                    Value="Center" />
            <Setter Property="TextWrapping"
                    Value="Wrap" />
            <Setter Property="MaxWidth"
                    Value="300" />
            <Setter Property="MinWidth"
                    Value="150" />
            <Setter Property="TextAlignment"
                    Value="Center" />
        </Style>

        <Style Selector="TransitioningContentControl#EmptyTextCntrContentControl">
            <Setter Property="Content">
                <Setter.Value>
                    <Template>
                        <TextBlock Classes="empty-label">
                            <TextBlock.Inlines>
                                <Run Text="" />
                            </TextBlock.Inlines>
                        </TextBlock>
                    </Template>
                </Setter.Value>
            </Setter>
        </Style>

        <Style Selector="TransitioningContentControl#EmptyTextCntrContentControl.init">
            <Setter Property="Content">
                <Setter.Value>
                    <Template>
                        <TextBlock Classes="empty-label">
                            <TextBlock.Inlines>
                                <Run Text="Loading..." />
                            </TextBlock.Inlines>
                        </TextBlock>
                    </Template>
                </Setter.Value>
            </Setter>
        </Style>

        <Style Selector="TransitioningContentControl#EmptyTextCntrContentControl.empty-inst:not(.init)">
            <Setter Property="Content">
                <Setter.Value>
                    <Template>
                        <TextBlock Classes="empty-label">
                            <TextBlock.Inlines>
                                <Run Text="Add an" />
                                <Run Text="instrument."
                                     Classes="subject2" />
                            </TextBlock.Inlines>
                        </TextBlock>
                    </Template>
                </Setter.Value>
            </Setter>
        </Style>

        <Style Selector="TransitioningContentControl#EmptyTextCntrContentControl.no-inst-sel:not(.init)">
            <Setter Property="Content">
                <Setter.Value>
                    <Template>
                        <TextBlock Classes="empty-label">
                            <TextBlock.Inlines>
                                <Run Text="Select an" />
                                <Run Text="instrument."
                                     Classes="subject2" />
                            </TextBlock.Inlines>
                        </TextBlock>
                    </Template>
                </Setter.Value>
            </Setter>
        </Style>
        <Style Selector="TransitioningContentControl#EmptyTextCntrContentControl.no-tuning-sel:not(.init)">
            <Setter Property="Content">
                <Setter.Value>
                    <Template>
                        <TextBlock Classes="empty-label">
                            <TextBlock.Inlines>
                                <Run Text="Select a" />
                                <Run Text="tuning."
                                     Classes="subject2" />
                            </TextBlock.Inlines>
                        </TextBlock>
                    </Template>
                </Setter.Value>
            </Setter>
        </Style>

        <Style
            Selector="TransitioningContentControl#EmptyTextCntrContentControl.empty-tuning:not(.empty-inst):not(.init)">
            <Setter Property="Content">
                <Setter.Value>
                    <Template>
                        <TextBlock Classes="empty-label">
                            <TextBlock.Inlines>
                                <Run Text="{Binding SelectedInstrument.Title}"
                                     Classes="article" />
                                <Run Text="needs a" />
                                <Run Text="tuning."
                                     Classes="subject2" />
                            </TextBlock.Inlines>
                        </TextBlock>
                    </Template>
                </Setter.Value>
            </Setter>
        </Style>

        <Style
            Selector="TransitioningContentControl#EmptyTextCntrContentControl.search-mode:not(.no-sel):not(.empty-tuning):not(.empty-inst):not(.init)">
            <Setter Property="Content">
                <Setter.Value>
                    <Template>
                        <TextBlock Classes="empty-label">
                            <TextBlock.Inlines>
                                <Run Text="No results." />
                            </TextBlock.Inlines>
                        </TextBlock>
                    </Template>
                </Setter.Value>
            </Setter>
        </Style>

        <Style
            Selector="TransitioningContentControl#EmptyTextCntrContentControl.search-mode.no-sel:not(.empty-tuning):not(.empty-inst):not(.init)">
            <Setter Property="Content">
                <Setter.Value>
                    <Template>
                        <TextBlock Classes="empty-label">
                            <TextBlock.Inlines>
                                <Run Text="Select" />
                                <Run Text="frets."
                                     Classes="subject2" />
                            </TextBlock.Inlines>
                        </TextBlock>
                    </Template>
                </Setter.Value>
            </Setter>
        </Style>

        <Style
            Selector="TransitioningContentControl#EmptyTextCntrContentControl.search-mode.no-sel.piano:not(.empty-tuning):not(.empty-inst):not(.init)">
            <Setter Property="Content">
                <Setter.Value>
                    <Template>
                        <TextBlock Classes="empty-label">
                            <TextBlock.Inlines>
                                <Run Text="Select" />
                                <Run Text="keys."
                                     Classes="subject2" />
                            </TextBlock.Inlines>
                        </TextBlock>
                    </Template>
                </Setter.Value>
            </Setter>
        </Style>

        <Style Selector="TransitioningContentControl#EmptyTextCntrContentControl.bookmark-mode:not(.init)">
            <Setter Property="Content">
                <Setter.Value>
                    <Template>
                        <TextBlock Classes="empty-label">
                            <TextBlock.Inlines>
                                <Run Text="No" />
                                <Run Text="{Binding PatternSingularName}"
                                     Classes="article2" />
                                <Run Text="bookmarks found."
                                     Classes="subject2" />

                            </TextBlock.Inlines>
                        </TextBlock>
                    </Template>
                </Setter.Value>
            </Setter>
        </Style>

        <Style Selector="TransitioningContentControl#EmptyTextCntrContentControl.index-mode:not(.init)">
            <Setter Property="Content">
                <Setter.Value>
                    <Template>
                        <TextBlock Classes="empty-label">
                            <TextBlock.Inlines>
                                <!-- <Run Text="No" /> -->
                                <!-- <Run Text="{Binding PatternSingularName}" -->
                                <!--      Classes="article2" /> -->
                                <!-- <Run Text="results" -->
                                <!--      Classes="subject2" /> -->
                                <!-- <Run Text="found." /> -->
                                <Run Text="Loading..." />
                            </TextBlock.Inlines>
                        </TextBlock>
                    </Template>
                </Setter.Value>
            </Setter>
        </Style>

        <Style Selector="TransitioningContentControl#EmptyTextCntrContentControl[IsVisible=False]">
            <Setter Property="Content"
                    Value="{x:Null}" />
        </Style>
    </UserControl.Styles>
    <!-- <Viewbox> -->
    <Grid>
        <!-- RESULTS CNTR -->

        <Border x:Name="ResultContainer"
                CornerRadius="5">
            <Border.Background>
                <SolidColorBrush Color="{DynamicResource BgColor}"
                                 Opacity="0.3" />
            </Border.Background>
            <Border.IsVisible>
                <MultiBinding Converter="{x:Static BoolConverters.And}">
                    <Binding Path="!IsSearchButtonVisible" />
                    <Binding Path="!IsVisible"
                             ElementName="EmptyTextCntrContentControl" />
                </MultiBinding>

            </Border.IsVisible>

            <Grid RowDefinitions="Auto,*">

                <ScrollViewer x:Name="MatchesScrollViewer"
                              Classes.drawer-test="false"
                              Grid.Row="1">
                    <Viewbox VerticalAlignment="Top">
                        <!-- NOTE no margin/padding on repeater to get accurate bounds -->
                        <ItemsRepeater x:Name="MatchItemsRepeater"
                                       Width="{Binding MatchesViewFixedWidth}"
                                       Classes.can-resize="true"
                                       ItemsSource="{Binding Matches}">
                            <ItemsRepeater.Layout>
                                <WrapLayout Orientation="Horizontal" />
                                <!-- <UniformGridLayout MaximumRowsOrColumns="{Binding MatchColCount}" /> -->
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="local:MatchViewModel">
                                    <local:MatchView Background="{DynamicResource HttTransparent}"
                                                     MaxWidth="{local:MathBinding a={Binding $parent[ItemsRepeater].Bounds.Width}, b={Binding MatchColCount, Source={x:Static local:MainViewModel.Instance}}, exp=(a/b)-10}"
                                                     Focusable="True" />
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </Viewbox>
                </ScrollViewer>

                <!-- SHARE -->
                <controls:Card Grid.Row="0"
                               Classes="button-group"
                               Margin="10"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center">
                    <Button x:Name="ExportButton"
                            local:CloseFlyoutExtension.IsEnabled="True"
                            IsEnabled="{Binding !IsMatchesEmpty}"
                            Padding="8"
                            Classes="float">

                        <ToolTip.Tip>
                            <controls:Card Classes="tt">
                                <TextBlock Text="Open in new tab..." />
                            </controls:Card>
                        </ToolTip.Tip>
                        <Button.Flyout>
                            <Flyout>
                                <ContextMenu Placement="AnchorAndGravity"
                                             PlacementAnchor="TopRight"
                                             PlacementGravity="BottomRight">
                                    <MenuItem Header="Save as html..."
                                              Command="{Binding ExportMatchesCommand, Source={x:Static local:MainViewModel.Instance}}"
                                              CommandParameter="HTML">
                                        <MenuItem.Icon>
                                            <avalonia:MaterialIcon Kind="CodeBlockTags" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Save as pdf..."
                                              Command="{Binding ExportMatchesCommand, Source={x:Static local:MainViewModel.Instance}}"
                                              CommandParameter="FULLPDF">
                                        <MenuItem.Icon>
                                            <avalonia:MaterialIcon Kind="FilePdfBox" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                </ContextMenu>
                            </Flyout>
                        </Button.Flyout>

                        <avalonia:MaterialIcon Kind="Share" />
                    </Button>
                </controls:Card>

                <!-- BUSY OVERLAY -->

                <Border x:Name="MatchesBusyOverlay"
                        Grid.RowSpan="2"
                        Classes="busy-cntr">
                    <Border.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                            <Binding Path="!IsBusy" />
                            <MultiBinding Converter="{x:Static BoolConverters.Or}">
                                <Binding Path="IsSearchInitiating" />
                                <Binding Path="IsMatchZoomChanging" />
                            </MultiBinding>
                        </MultiBinding>
                    </Border.IsVisible>
                </Border>


                <!-- ZOOM BTNS -->
                <controls:Card Grid.Row="0"
                               x:Name="ZoomButtonCard"
                               Classes="button-group"
                               Classes.right-drawer-float="{Binding !IsPhone, Source={x:Static local:ThemeViewModel.Instance}}"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Margin="10">
                    <StackPanel Orientation="Horizontal">
                        <!-- ZOOM OUT (COLS+1) -->
                        <Button x:Name="ZoomMinusButton"
                                Classes="float"
                                Command="{Binding IncreaseMatchColumnsCommand}">
                            <avalonia:MaterialIcon Kind="Minus" />
                        </Button>
                        <!-- ZOOM IN (COLS-1) -->
                        <Button x:Name="ZoomPlusButton"
                                Classes="float"
                                Command="{Binding DecreaseMatchColumnsCommand}">
                            <avalonia:MaterialIcon Kind="Plus" />
                        </Button>
                    </StackPanel>
                </controls:Card>
            </Grid>
        </Border>

        <!-- SEARCH OVERLAY -->

        <StackPanel x:Name="SearchOverlay"
                    Spacing="5"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
            <!-- SEARCH BUTTON -->

            <Button x:Name="SearchButton"
                    Classes="accent fade fade-collapse"
                    Padding="16"
                    MinWidth="64"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsVisible="{Binding IsSearchButtonVisible}"
                    Height="{Binding $self.Bounds.Width}"
                    Command="{Binding FindMatchesCommand}">
                <avalonia:MaterialIcon Kind="Search"
                                       MinWidth="48"
                                       Height="{Binding $self.Bounds.Width}" />
            </Button>

            <!-- EMPTY LABEL -->

            <TransitioningContentControl x:Name="EmptyTextCntrContentControl"
                                         Classes.piano="{Binding IsPianoSelected}"
                                         Classes.init="{Binding !IsLoaded}"
                                         Classes.no-inst-sel="{Binding SelectedInstrument, Converter={x:Static ObjectConverters.IsNull}}"
                                         Classes.no-tuning-sel="{Binding SelectedTuning, Converter={x:Static ObjectConverters.IsNull}}"
                                         Classes.no-sel="{Binding IsDefaultSelection}"
                                         Classes.empty-inst="{Binding IsInstrumentsEmpty}"
                                         Classes.empty-tuning="{Binding IsTuningsEmpty}"
                                         Classes.search-mode="{Binding IsSearchModeSelected}"
                                         Classes.bookmark-mode="{Binding IsBookmarkModeSelected}"
                                         Classes.index-mode="{Binding IsIndexModeSelected}">
                <TransitioningContentControl.PageTransition>
                    <CrossFade Duration="0:0:0.5" />
                </TransitioningContentControl.PageTransition>
                <TransitioningContentControl.IsVisible>
                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                        <Binding Path="!IsSearchButtonVisible" />
                        <Binding Path="IsMatchesEmpty" />
                        <Binding Path="!IsLoadingMatches" />
                        <Binding Path="!IsSearchInitiating" />
                        <Binding Path="IsLoaded" />
                    </MultiBinding>
                </TransitioningContentControl.IsVisible>

            </TransitioningContentControl>

            <!-- RESET -->
            <HyperlinkButton x:Name="ResetInstrumentLinkBUtton"
                             Classes="fade fade-collapse"
                             Cursor="Hand"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             VerticalContentAlignment="Center"
                             Opacity="{Binding !IsDefaultSelection, ConverterParameter=1|0, Converter={x:Static common:MpAvBoolToDoubleConverter.Instance}}"
                             Command="{Binding ResetInstrumentCommand}">
                <HyperlinkButton.IsVisible>
                    <MultiBinding Converter="{x:Static BoolConverters.Or}">
                        <Binding Path="IsVisible"
                                 ElementName="SearchButton" />
                        <Binding Path="IsVisible"
                                 ElementName="EmptyTextCntrContentControl" />
                    </MultiBinding>
                </HyperlinkButton.IsVisible>
                <TextBlock Background="Transparent"
                           Width="{Binding Bounds.Width, ElementName=SearchButton}"
                           MinHeight="20"
                           TextAlignment="Center"
                           Classes="Body1"
                           Text="Reset" />
            </HyperlinkButton>

        </StackPanel>


    </Grid>
    <!-- </Viewbox> -->
</UserControl>