<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="800"
             d:DesignHeight="450"
             xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:controls="clr-namespace:Material.Styles.Controls;assembly=Material.Styles"
             xmlns:dlg="clr-namespace:DialogHostAvalonia;assembly=DialogHost.Avalonia"
             xmlns:local="clr-namespace:Calcuchord"
             xmlns:common="clr-namespace:MonkeyPaste.Common.Avalonia;assembly=MonkeyPaste.Common.Avalonia"
             xmlns:system="clr-namespace:System;assembly=System.Runtime"
             x:Class="Calcuchord.SortItemView"
             x:DataType="local:OptionViewModel">
    <UserControl.Styles>
        <Style Selector="Button.sub">
            <Setter Property="IsVisible">
                <Setter.Value>
                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                        <Binding Path="$parent[Button].DataContext"
                                 ConverterParameter="$self.Data"
                                 Converter="{x:Static ObjectConverters.NotEqual}" />
                    </MultiBinding>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Styles>
    <TransitioningContentControl Content="{Binding .}">
        <TransitioningContentControl.PageTransition>
            <PageSlide Orientation="Horizontal"
                       Duration="0:0:0.5" />
        </TransitioningContentControl.PageTransition>
        <TransitioningContentControl.ContentTemplate>
            <DataTemplate x:DataType="local:OptionViewModel">
                <Grid Classes="opt-item"
                      ColumnDefinitions="Auto,*">
                    <ToggleButton Classes="opt-btn"
                                  Width="20"
                                  Padding="0"
                                  IsChecked="{Binding IsChecked, Mode=OneWay}"
                                  IsVisible="{Binding IsSecondaryVisible}"
                                  Command="{Binding SelectOptionCommand, Source={x:Static local:MainViewModel.Instance}}">
                        <ToggleButton.CommandParameter>
                            <MultiBinding Converter="{x:Static local:MultiObjectConverter.Instance}">
                                <Binding />
                                <Binding Path="IsChecked" />
                            </MultiBinding>
                        </ToggleButton.CommandParameter>
                        <avalonia:MaterialIcon HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                    </ToggleButton>
                    <!-- <Button x:Name="SortPropButton" -->
                    <!--         Grid.Column="1" -->
                    <!--         Classes="opt-btn key" -->
                    <!--         Command="{Binding SelectOptionCommand, Source={x:Static local:MainViewModel.Instance}}" -->
                    <!--         CommandParameter="{Binding .}"> -->
                    <!--     <Viewbox StretchDirection="DownOnly"> -->
                    <!--         <TextBlock /> -->
                    <!--     </Viewbox> -->
                    <!-- -->
                    <!-- </Button> -->

                    <Button x:Name="SortPropButton"
                            Grid.Column="1"
                            local:CloseFlyoutExtension.IsEnabled="{Binding IsDesktop, Source={x:Static local:ThemeViewModel.Instance}}"
                            Classes="opt-btn key">
                        <Button.Styles>
                            <Style Selector="FlyoutPresenter">
                                <Setter Property="Margin"
                                        Value="0" />
                                <Setter Property="Padding"
                                        Value="0" />
                                <Setter Property="CornerRadius"
                                        Value="5" />
                            </Style>
                            <Style Selector="Button.sub">
                                <Setter Property="Padding"
                                        Value="15,6" />
                            </Style>
                        </Button.Styles>
                        <Button.Flyout>
                            <Flyout Opened="FlyoutBase_OnOpened">
                                <controls:ColorZone Mode="Inverted"
                                                    Foreground="{DynamicResource Bg}">
                                    <StackPanel x:DataType="local:MainViewModel"
                                                DataContext="{x:Static local:MainViewModel.Instance}">
                                        <Button Classes="sub opt-btn key"
                                                DataContext="{Binding SortOption1}"
                                                Classes.is-score="{Binding ConverterParameter=0, Converter={x:Static local:IsScoreOptionConverter.Instance}}"
                                                Command="{Binding SelectOptionCommand, Source={x:Static local:MainViewModel.Instance}}">
                                            <Button.CommandParameter>
                                                <MultiBinding
                                                    Converter="{x:Static local:MultiObjectConverter.Instance}">
                                                    <Binding Path="DataContext"
                                                             ElementName="SortPropButton" />
                                                    <Binding />
                                                </MultiBinding>
                                            </Button.CommandParameter>
                                            <Viewbox StretchDirection="DownOnly">
                                                <TextBlock />
                                            </Viewbox>
                                        </Button>
                                        <Button Classes="sub opt-btn key"
                                                DataContext="{Binding SortOption2, Source={x:Static local:MainViewModel.Instance}}"
                                                Classes.is-score="{Binding ConverterParameter=1, Converter={x:Static local:IsScoreOptionConverter.Instance}}"
                                                Command="{Binding SelectOptionCommand, Source={x:Static local:MainViewModel.Instance}}">
                                            <Button.CommandParameter>
                                                <MultiBinding
                                                    Converter="{x:Static local:MultiObjectConverter.Instance}">
                                                    <Binding Path="DataContext"
                                                             ElementName="SortPropButton" />
                                                    <Binding />
                                                </MultiBinding>
                                            </Button.CommandParameter>
                                            <Viewbox StretchDirection="DownOnly">
                                                <TextBlock />
                                            </Viewbox>
                                        </Button>
                                        <Button Classes="sub opt-btn key"
                                                DataContext="{Binding SortOption3, Source={x:Static local:MainViewModel.Instance}}"
                                                Classes.is-score="{Binding ConverterParameter=2, Converter={x:Static local:IsScoreOptionConverter.Instance}}"
                                                Command="{Binding SelectOptionCommand, Source={x:Static local:MainViewModel.Instance}}">
                                            <Button.CommandParameter>
                                                <MultiBinding
                                                    Converter="{x:Static local:MultiObjectConverter.Instance}">
                                                    <Binding Path="DataContext"
                                                             ElementName="SortPropButton" />
                                                    <Binding />
                                                </MultiBinding>
                                            </Button.CommandParameter>
                                            <Viewbox StretchDirection="DownOnly">
                                                <TextBlock />
                                            </Viewbox>
                                        </Button>
                                        <Button Classes="sub opt-btn key"
                                                DataContext="{Binding SortOption4, Source={x:Static local:MainViewModel.Instance}}"
                                                Classes.is-score="{Binding ConverterParameter=3, Converter={x:Static local:IsScoreOptionConverter.Instance}}"
                                                Command="{Binding SelectOptionCommand, Source={x:Static local:MainViewModel.Instance}}">
                                            <Button.CommandParameter>
                                                <MultiBinding
                                                    Converter="{x:Static local:MultiObjectConverter.Instance}">
                                                    <Binding Path="DataContext"
                                                             ElementName="SortPropButton" />
                                                    <Binding />
                                                </MultiBinding>
                                            </Button.CommandParameter>
                                            <Viewbox StretchDirection="DownOnly">
                                                <TextBlock />
                                            </Viewbox>
                                        </Button>
                                    </StackPanel>
                                </controls:ColorZone>

                            </Flyout>
                        </Button.Flyout>
                        <Viewbox StretchDirection="DownOnly">
                            <TextBlock />
                        </Viewbox>

                    </Button>

                </Grid>

            </DataTemplate>
        </TransitioningContentControl.ContentTemplate>
    </TransitioningContentControl>
</UserControl>