<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="800"
             d:DesignHeight="450"
             xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:controls="clr-namespace:Material.Styles.Controls;assembly=Material.Styles"
             xmlns:dlg="clr-namespace:DialogHostAvalonia;assembly=DialogHost.Avalonia"
             xmlns:local="clr-namespace:Calcuchord"
             xmlns:common="clr-namespace:MonkeyPaste.Common.Avalonia;assembly=MonkeyPaste.Common.Avalonia"
             xmlns:system="clr-namespace:System;assembly=System.Runtime"
             x:DataType="local:BookmarkGroupViewModel"
             x:Class="Calcuchord.BookmarkGroupItemView">
    <UserControl.Styles>
        <Style Selector="avalonia|MaterialIcon#AddNewIcon">
            <Setter Property="IsVisible"
                    Value="False" />
        </Style>

        <Style Selector="StackPanel.add-new avalonia|MaterialIcon#AddNewIcon">
            <Setter Property="IsVisible"
                    Value="True" />
        </Style>

        <Style Selector="StackPanel.add-new Border#GroupColorBorder">
            <Setter Property="IsVisible"
                    Value="False" />
        </Style>

        <Style Selector="TextBlock">
            <Setter Property="TextAlignment"
                    Value="Center" />
        </Style>
        <Style Selector="TextBlock.add-new">
            <Setter Property="TextAlignment"
                    Value="Left" />
        </Style>


    </UserControl.Styles>
    <Border x:Name="GroupColorBorder"
            CornerRadius="5"
            Height="{Binding IsAddGroupPlaceholder, ConverterParameter=40|25, Converter={x:Static common:MpAvBoolToDoubleConverter.Instance}}"
            Margin="3"
            Background="{Binding HexColor, Converter={x:Static local:HexToBrushOrColorConverter.Instance}}">
        <Grid ColumnDefinitions="Auto,*">
            <avalonia:MaterialIcon x:Name="AddNewIcon"
                                   IsVisible="{Binding IsAddGroupPlaceholder}"
                                   Foreground="ForestGreen"
                                   Kind="Add"
                                   Margin="3"
                                   Width="25"
                                   Height="25" />
            <TextBlock Grid.Column="1"
                       Classes.add-new="{Binding IsAddGroupPlaceholder}"
                       HorizontalAlignment="Stretch"
                       VerticalAlignment="Center"
                       Foreground="Black"
                       Text="{Binding GroupName}" />
        </Grid>
    </Border>
</UserControl>